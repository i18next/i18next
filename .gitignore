# Ignore specific files
.settings.xml
.monitor
.DS_Store
*.orig
npm-debug.log
npm-debug.log.*
*.dat
.vscode
.attest

# Ignore various temporary files
*~
*.swp

# Ignore various Node.js related directories and files
node_modules
node_modules/**/*
coverage/**/*
dist/**/*

# root copies of dist/umd, made by `npm run build` and published for the unversioned unpkg URLs
/i18next.js
/i18next.min.js

# Ignore IntelliJ based IDEs project files
.idea

# vitest temp / cache files
tsconfig.vitest-temp.json
tsconfig.nonEsModuleInterop.vitest-temp.json

# Generated in CI by .github/workflows/publish-jsr.yml
jsr.json

# Secrets & credentials
.env
.env.*
!.env.example
*.pem
*.key